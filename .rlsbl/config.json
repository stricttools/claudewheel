{
  "changelog_format_version_enforced": true,
  "internal_dep_floors": [
    "strictcli",
    "stricttest"
  ],
  "targets": [
    "npm",
    "pypi"
  ],
  "publish_mode": "ci",
  "push_timeout": 120,
  "env_file": "~/Projects/.env",
  "pipelines": {
    "npm": {
      "type": "npm",
      "target": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "target": "pypi",
      "local": false
    }
  },
  "checks": {
    "type-check": {
      "paths": [
        "claudewheel",
        "tests",
        "docs"
      ]
    },
    "lint": {
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        "docs"
      ]
    },
    "format": {
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        "docs"
      ]
    }
  },
  "external_checks": [
    {
      "name": "autospec-tests",
      "kind": "freeform",
      "command": "python3 scripts/gates/check-autospec",
      "tag": "preflight"
    }
  ],
  "batch_limits": {
    "exclusions": []
  }
}
