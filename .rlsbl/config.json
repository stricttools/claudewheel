{
  "internal_dep_floors": [
    "strictcli",
    "testisolation",
    "strictspec"
  ],
  "targets": [
    "npm",
    "pypi"
  ],
  "publish_mode": "ci",
  "push_timeout": 120,
  "env_file": "~/Projects/.env",
  "pipelines": {
    "npm": {
      "type": "npm",
      "target": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "target": "pypi",
      "local": false
    }
  },
  "checks": {
    "type-check": {
      "paths": [
        "claudewheel",
        "tests",
        ".strictmetadata/docs"
      ]
    },
    "lint": {
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        ".strictmetadata/docs"
      ]
    },
    "format": {
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        ".strictmetadata/docs"
      ]
    }
  },
  "external_checks": [
    {
      "name": "autospec-tests",
      "kind": "freeform",
      "command": "python3 scripts/gates/check-autospec",
      "tag": "preflight"
    }
  ],
  "batch_limits": {
    "exclusions": [
      {
        "reason": "one feature, the OOM kill reports and probes, built in nine commits (store, heavy description, runner, commands, hooks, service, overview column, wiring, docs); splitting the entry would split one feature",
        "entries": [
          {
            "version": "unreleased",
            "line": 34
          }
        ]
      }
    ]
  }
}
