{
  "changelog_format_version_enforced": true,
  "targets": [
    "npm",
    "pypi"
  ],
  "publish_mode": "ci",
  "push_timeout": 120,
  "env_file": "~/Projects/.env",
  "pipelines": {
    "npm": {
      "type": "npm",
      "target": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "target": "pypi",
      "local": false
    }
  },
  "external_checks": [
    {
      "name": "mypy-strict",
      "kind": "structured",
      "tool": "mypy",
      "paths": [
        "claudewheel",
        "tests",
        "docs"
      ],
      "tag": "preflight"
    },
    {
      "name": "ruff-check",
      "kind": "structured",
      "tool": "ruff-check",
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        "docs"
      ],
      "tag": "preflight"
    },
    {
      "name": "ruff-format",
      "kind": "structured",
      "tool": "ruff-format",
      "paths": [
        "claudewheel",
        "tests",
        "scripts",
        "docs"
      ],
      "tag": "preflight"
    },
    {
      "name": "autospec-tests",
      "kind": "freeform",
      "command": "python3 scripts/gates/check-autospec",
      "tag": "preflight"
    }
  ],
  "batch_limits": {
    "exclusions": []
  }
}
