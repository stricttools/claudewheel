def reconcile_cases():
    import copy

    from claudewheel import defaults, reconcile

    scripts = Path("/home/u/.claudewheel/scripts")
    canonical = defaults.build_canonical_shared_settings(scripts)
    cases = []
    for target, inputs, fn in (
        ("profile", RECONCILE_PROFILE_INPUTS, reconcile.reconcile_profile_dict),
        ("shared", RECONCILE_SHARED_INPUTS, reconcile.reconcile_shared_dict),
    ):
        for value in inputs:
            work = copy.deepcopy(value)
            changes = fn(work, canonical)
            cases.append({
                "target": target,
                "input": json.dumps(value, indent=2) + "\n",
                "output": json.dumps(work, indent=2) + "\n",
                "changes": changes,
            })
    return {"scripts_dir": str(scripts), "cases": cases}


# Session-operation scenarios. A tree is a list of entries; "@ROOT@" in a path,
# a content, or a link target stands for the scenario's root directory, and
# "@EROOT@" for Claude Code's store-dir encoding of it.
U1 = "11111111-1111-4111-8111-111111111111"
U2 = "22222222-2222-4222-8222-222222222222"


def _line(**fields):
    return json.dumps(fields, ensure_ascii=False, separators=(",", ":"))


def _transcript(session, cwd, extra=()):
    lines = [
        _line(type="user", sessionId=session, cwd=cwd, message={"content": "hi from " + cwd + " caf\u00e9"}),
        _line(type="assistant", sessionId=session, cwd=cwd, toolUseResult={"filePath": cwd + "/src/main.go"}),
    ]
    lines += list(extra)
    return "\n".join(lines) + "\n"


def _profile(name, shared_links=True):
    entries = [{"path": ".claudewheel/profiles/" + name + "/settings.json", "type": "file", "content": "{}\n"}]
    if shared_links:
        for d in ("projects", "todos", "session-env", "file-history", "tasks"):
            entries.append({"path": ".claudewheel/profiles/" + name + "/" + d, "type": "symlink",
                            "target": "@ROOT@/.claudewheel/shared/" + d})
    return entries


def _shared_dirs():
    return [{"path": ".claudewheel/shared/" + d, "type": "dir"} for d in
            ("projects", "todos", "session-env", "file-history", "tasks", "paste-cache")]


def _store(cwd_rel, session, cwd=None, extra=()):
    cwd = cwd or "@ROOT@/" + cwd_rel
    enc = "@EROOT@-" + cwd_rel.replace("/", "-")
    return [{"path": ".claudewheel/shared/projects/" + enc + "/" + session + ".jsonl", "type": "file",
             "content": _transcript(session, cwd, extra)}]


def _claude_json(name, keys):
    doc = {"numStartups": 3, "projects": {k: {"allowedTools": [], "hasTrustDialogAccepted": True} for k in keys},
           "githubRepoPaths": {"me/repo": keys}}
    return {"path": ".claudewheel/profiles/" + name + "/.claude.json", "type": "file",
            "content": json.dumps(doc, indent=2) + "\n"}


def session_scenarios():
    folder_line = _line(type="user", sessionId=U1, toolUseResult={
        "path": "@ROOT@/.claudewheel/shared/projects/@EROOT@-work-a/" + U1 + "/tool-results/x.txt"})
    base = _shared_dirs() + _profile("p1") + _profile("p2")
    return [
        {
            "name": "mv renames a project and its nested project",
            "tree": base + [
                {"path": "work/a/file.txt", "type": "file", "content": "x"},
                {"path": "work/a/sub/f", "type": "file", "content": "y"},
                _claude_json("p1", ["@ROOT@/work/a", "@ROOT@/work/a/sub", "@ROOT@/work/ab"]),
            ] + _store("work/a", U1) + _store("work/a/sub", U2) + _store("work/ab", "33333333-3333-4333-8333-333333333333"),
            "op": {"name": "mv", "old": "@ROOT@/work/a", "new": "@ROOT@/work/b", "post_hoc": False},
        },
        {
            "name": "mv after the directory was renamed",
            "tree": base + [
                {"path": "work/b/file.txt", "type": "file", "content": "x"},
                _claude_json("p2", ["@ROOT@/work/a"]),
            ] + _store("work/a", U1),
            "op": {"name": "mv", "old": "@ROOT@/work/a", "new": "@ROOT@/work/b", "post_hoc": True},
        },
        {
            "name": "mv refuses an existing target",
            "tree": base + [
                {"path": "work/a/file.txt", "type": "file", "content": "x"},
                {"path": "work/b/file.txt", "type": "file", "content": "y"},
            ] + _store("work/a", U1),
            "op": {"name": "mv", "old": "@ROOT@/work/a", "new": "@ROOT@/work/b", "post_hoc": False},
        },
        {
            "name": "move-session moves a transcript and its folder",
            "tree": base + [
                {"path": "work/a/f", "type": "file", "content": "x"},
                {"path": "work/c/f", "type": "file", "content": "x"},
                {"path": ".claudewheel/shared/projects/@EROOT@-work-a/" + U1 + "/tool-results/x.txt", "type": "file", "content": "result"},
            ] + _store("work/a", U1, extra=[folder_line]) + _store("work/a", U2),
            "op": {"name": "move-session", "session": U1, "directory": "@ROOT@/work/c"},
        },
        {
            "name": "move-session leaves no empty source store",
            "tree": base + [
                {"path": "work/c/f", "type": "file", "content": "x"},
            ] + _store("work/a", U1),
            "op": {"name": "move-session", "session": U1, "directory": "@ROOT@/work/c"},
        },
        {
            "name": "import maps a foreign home",
            "tree": base + [
                {"path": "work/proj/f", "type": "file", "content": "x"},
                {"path": "ext/projects/-home-olduser-proj/" + U1 + ".jsonl", "type": "file",
                 "content": _transcript(U1, "/home/olduser/proj")},
                {"path": "ext/projects/-home-olduser-proj/" + U1 + "/sub/agent.jsonl", "type": "file",
                 "content": _line(cwd="/home/olduser/proj/x", sessionId=U1) + "\n"},
                {"path": "ext/todos/" + U1 + "-agent-" + U1 + ".json", "type": "file", "content": "[]"},
                {"path": "ext/file-history/" + U1 + "/v1", "type": "file", "content": "old"},
                {"path": "ext/paste-cache/abc.txt", "type": "file", "content": "paste"},
            ],
            "op": {"name": "import", "source": "@ROOT@/ext", "mappings": [["/home/olduser/proj", "@ROOT@/work/proj"]]},
        },
        {
            "name": "import reports a colliding session",
            "tree": base + [
                {"path": "work/proj/f", "type": "file", "content": "x"},
                {"path": "ext/projects/-home-olduser-proj/" + U1 + ".jsonl", "type": "file",
                 "content": _transcript(U1, "/home/olduser/proj")},
            ] + _store("work/proj", U1),
            "op": {"name": "import", "source": "@ROOT@/ext", "mappings": [["/home/olduser/proj", "@ROOT@/work/proj"]]},
        },
        {
            "name": "migrate moves one session between profiles",
            "tree": _shared_dirs() + _profile("p1", shared_links=False) + _profile("p2", shared_links=False) + [
                {"path": ".claudewheel/profiles/p1/projects/-x/" + U1 + ".jsonl", "type": "file", "content": "{}\n"},
                {"path": ".claudewheel/profiles/p1/projects/-x/" + U1 + "/a.txt", "type": "file", "content": "a"},
                {"path": ".claudewheel/profiles/p1/projects/-x/" + U2 + ".jsonl", "type": "file", "content": "{}\n"},
                {"path": ".claudewheel/profiles/p1/todos/" + U1 + "-agent-" + U1 + ".json", "type": "file", "content": "[]"},
                {"path": ".claudewheel/profiles/p1/session-env/" + U1 + "/e", "type": "file", "content": "e"},
                {"path": ".claudewheel/profiles/p2/projects", "type": "dir"},
            ],
            "op": {"name": "migrate", "src": "p1", "dst": "p2", "session": U1},
        },
    ]


def _encode_root(root):
    from claudewheel.shared_store import SharedStore

    return SharedStore.encode_path_untruncated(root)


def _materialize(root, tree):
    eroot = _encode_root(str(root))
    for e in tree:
        path = root / e["path"].replace("@EROOT@", eroot)
        if e["type"] == "dir":
            path.mkdir(parents=True, exist_ok=True)
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        if e["type"] == "file":
            path.write_bytes(e["content"].replace("@ROOT@", str(root)).replace("@EROOT@", eroot).encode())
        else:
            path.symlink_to(e["target"].replace("@ROOT@", str(root)))


def _dump(root):
    eroot = _encode_root(str(root))

    def norm(text):
        return text.replace(str(root), "@ROOT@").replace(eroot, "@EROOT@")

    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        for name in sorted(dirnames + filenames):
            full = Path(dirpath) / name
            rel = norm(str(full.relative_to(root)))
            if full.is_symlink():
                out.append({"path": rel, "type": "symlink", "target": norm(os.readlink(full))})
            elif full.is_dir():
                if not any(full.iterdir()):
                    out.append({"path": rel, "type": "dir"})
            else:
                out.append({"path": rel, "type": "file", "content": norm(full.read_bytes().decode())})
        dirnames[:] = [d for d in dirnames if not (Path(dirpath) / d).is_symlink()]
    return sorted(out, key=lambda e: e["path"])


def run_session_scenarios(out):
    import tempfile

    from claudewheel import import_, migrate, mv, session_move
    from claudewheel.workspace import Workspace

    scenarios = session_scenarios()
    base = Path(out).resolve().parent / "python-session-scenarios.work"
    for sc in scenarios:
        root = Path(tempfile.mkdtemp(prefix="sc-", dir=str(Path.cwd() / "experiments")))
        _materialize(root, sc["tree"])
        os.environ["HOME"] = str(root)
        ws = Workspace.open(root / ".claudewheel", claude_dir=root / ".claude",
                            bin_dir=root / ".local" / "bin",
                            systemd_user_dir=root / ".config" / "systemd" / "user")
        op = sc["op"]
        sub = lambda v: v.replace("@ROOT@", str(root))
        error = None
        try:
            if op["name"] == "mv":
                mv.run_mv(ws, sub(op["old"]), sub(op["new"]), post_hoc=op["post_hoc"], quiet=True)
            elif op["name"] == "move-session":
                session_move.move_session(ws, op["session"], sub(op["directory"]), dry_run=False)
            elif op["name"] == "import":
                res = import_.run_import(ws.shared, sub(op["source"]), [(sub(a), sub(b)) for a, b in op["mappings"]])
                if res.collisions:
                    error = "collisions"
            elif op["name"] == "migrate":
                migrate.migrate_sessions(ws, op["src"], op["dst"], uuid_filter=op["session"])
        except Exception as exc:  # noqa: BLE001 -- the scenario records any refusal
            error = type(exc).__name__
        sc["error"] = error
        sc["result"] = _dump(root)
    return scenarios


def hook_cases():
    """Every hook run the Python's hook execution tests make, with what the
    hook printed and exited with, recorded while those tests run."""
    import importlib
    import subprocess
    import unittest

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    from claudewheel.hook_scripts import HOOK_SCRIPTS

    by_text = {text: name for name, text in HOOK_SCRIPTS.items()}
    recorded = []
    real_run = subprocess.run

    def recording_run(args, *a, **kw):
        proc = real_run(args, *a, **kw)
        if isinstance(args, list) and len(args) == 2 and args[0] == "bash":
            name = by_text.get(Path(args[1]).read_text()) if Path(args[1]).exists() else None
            if name is None:
                raise RuntimeError("a hook test ran an unknown script")
            if name != "hook-timestamp":
                recorded.append({"script": name, "stdin": kw.get("input", ""),
                                 "exit": proc.returncode, "stdout": proc.stdout})
        return proc

    subprocess.run = recording_run
    try:
        suite = unittest.TestSuite()
        for module in ("tests.test_hook_unsafe_exec", "tests.test_hook_advise_exec", "tests.test_hook_worktree_exec"):
            suite.addTests(unittest.defaultTestLoader.loadTestsFromModule(importlib.import_module(module)))
        # The outputs are recorded whether or not a test's own assertion
        # holds: they are what the hooks do (the heavy-unwrapped tests fail
        # since that rule was removed from the model).
        unittest.TextTestRunner(stream=sys.stderr, verbosity=0).run(suite)
    finally:
        subprocess.run = real_run
    return recorded


def _snapshot(root):
    """Every entry under root, with file contents and modification times."""
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        for name in sorted(dirnames + filenames):
            full = Path(dirpath) / name
            rel = str(full.relative_to(root))
            st = full.lstat()
            if full.is_symlink():
                out.append({"path": rel, "type": "symlink", "target": os.readlink(full)})
            elif full.is_dir():
                out.append({"path": rel, "type": "dir"})
            elif stat.S_ISFIFO(st.st_mode):
                out.append({"path": rel, "type": "fifo"})
            else:
                out.append({"path": rel, "type": "file", "content": full.read_bytes().decode(),
                            "mtime_ns": st.st_mtime_ns})
        dirnames[:] = [d for d in dirnames if not (Path(dirpath) / d).is_symlink()]
    return sorted(out, key=lambda e: e["path"])


def probe_runner_calls():
    """Every call the Python's probe runner tests make to process_entry,
    end_probes, settle_reports, and tick, with the workspace before and after
    each call, recorded while those tests run."""
    import importlib
    import unittest

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    from claudewheel import probe_runner

    recorded = []

    import re

    # The tests stand this process in for a live client; the replay puts its
    # own process id where this one's appears.
    pid = str(os.getpid())
    pid_spots = re.compile(r'(\\"pid\\": ?)' + pid + r'\b|(session-)' + pid + r'(-)')

    def norm(root, value):
        text = json.dumps(value).replace(str(root), "@ROOT@")
        return json.loads(pid_spots.sub(lambda m: (m.group(1) or m.group(2)) + "@PID@" + (m.group(3) or ""), text))

    def wrap(name):
        real = getattr(probe_runner, name)

        def recording(ws, *args, **kwargs):
            root = ws.root.parent
            call = {"fn": name, "before": norm(root, _snapshot(root)), "kwargs": {}}
            if name == "process_entry":
                call["entry"] = norm(root, args[0])
                described = {}
                describe = kwargs.get("describe", probe_runner.heavy_description)

                def recording_describe(unit):
                    described[unit] = describe(unit)
                    return described[unit]

                kwargs["describe"] = recording_describe
                call["described"] = described
            for k, v in kwargs.items():
                if k in ("now_ms", "expire", "states"):
                    call["kwargs"][k] = list(v) if isinstance(v, tuple) else v
            try:
                result = real(ws, *args, **kwargs)
                call["error"] = None
            except Exception as exc:  # noqa: BLE001 -- the recording keeps any refusal
                result = None
                call["error"] = type(exc).__name__
            call["after"] = norm(root, _snapshot(root))
            recorded.append(call)
            return result

        setattr(probe_runner, name, recording)
        return real

    reals = {n: wrap(n) for n in ("process_entry", "end_probes", "settle_reports", "tick")}
    try:
        module = importlib.import_module("tests.test_probe_runner")
        suite = unittest.defaultTestLoader.loadTestsFromModule(module)
        unittest.TextTestRunner(stream=sys.stderr, verbosity=0).run(suite)
    finally:
        for n, real in reals.items():
            setattr(probe_runner, n, real)
    return recorded


def _plain(value):
    """value as JSON-ready data: dataclasses become dicts, tuples lists."""
    import dataclasses

    if dataclasses.is_dataclass(value) and not isinstance(value, type):
        return {f.name: _plain(getattr(value, f.name)) for f in dataclasses.fields(value)}
    if isinstance(value, dict):
        return {str(k): _plain(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_plain(v) for v in value]
    return value


def _record_calls(test_modules, targets):
    """Run the unittest modules with each target (module, function name)
    wrapped so every call's arguments and result are recorded."""
    import importlib
    import unittest

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    calls = []
    modules = [importlib.import_module(m) for m in test_modules]
    restore = []
    for owner, name in targets:
        mod = importlib.import_module(owner)
        real = getattr(mod, name)

        def wrapper(*args, _name=name, _real=real, **kwargs):
            result = _real(*args, **kwargs)
            calls.append({"fn": _name, "args": _plain(list(args)), "kwargs": _plain(kwargs), "result": _plain(result)})
            return result

        for m in [mod, *modules]:
            if getattr(m, name, None) is real:
                setattr(m, name, wrapper)
                restore.append((m, name, real))
    try:
        suite = unittest.TestSuite()
        for m in modules:
            suite.addTests(unittest.defaultTestLoader.loadTestsFromModule(m))
        unittest.TextTestRunner(stream=sys.stderr, verbosity=0).run(suite)
    finally:
        for m, name, real in restore:
            setattr(m, name, real)
    return calls


def tui_calls():
    """Every call of the TUI's pure functions the Python's tests make:
    fuzzy matching, the vertical viewport, and the session row formats."""
    return _record_calls(
        ["tests.test_fuzzy", "tests.test_vertical_viewport", "tests.test_session_rows", "tests.test_sessions_table"],
        [("claudewheel.fuzzy", "fuzzy_score"), ("claudewheel.fuzzy", "fuzzy_rank"),
         ("claudewheel.fuzzy", "fuzzy_match_positions"),
         ("claudewheel.vertical_viewport", "compute_viewport"),
         ("claudewheel.session_rows", "format_uptime"), ("claudewheel.session_rows", "format_memory"),
         ("claudewheel.sessions_table", "tildify")],
    )


def _snapshot_modes(root):
    """_snapshot with each file's and directory's permission bits."""
    out = _snapshot(root)
    for e in out:
        if e["type"] in ("file", "dir"):
            e["mode"] = stat.S_IMODE((Path(root) / e["path"]).lstat().st_mode)
    return out


def health_calls():
    """Every check_* call of the Python's health tests that reads only the
    workspace, with the home directory before the call and its result."""
    import datetime
    import importlib
    import unittest

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    from claudewheel import health

    names = ["check_shared_symlinks", "check_hooks_wired", "check_settings_defaults",
             "check_shared_settings_drift", "check_canonical_permissions_drift",
             "check_deployed_hook_drift", "check_relocated_hook_paths", "check_tokens",
             "check_token_expiry", "check_auth_shadow", "check_orphan_profiles",
             "check_file_permissions"]
    module = importlib.import_module("tests.test_health")
    calls = []
    restore = []
    for name in names:
        real = getattr(health, name)

        def wrapper(ws, *args, _name=name, _real=real, **kwargs):
            home = ws.root.parent
            before = json.loads(json.dumps(_snapshot_modes(home)).replace(str(home), "@ROOT@"))
            result = _real(ws, *args, **kwargs)
            calls.append({
                "fn": _name, "today": datetime.date.today().isoformat(), "before": before,
                "label": result.label, "ok": result.ok,
                "detail": result.detail.replace(str(home), "@ROOT@"),
                "extra_args": len(args) + len(kwargs),
            })
            return result

        for m in (health, module):
            if getattr(m, name, None) is real:
                setattr(m, name, wrapper)
                restore.append((m, name, real))
    try:
        suite = unittest.defaultTestLoader.loadTestsFromModule(module)
        unittest.TextTestRunner(stream=sys.stderr, verbosity=0).run(suite)
    finally:
        for m, name, real in restore:
            setattr(m, name, real)
    return calls


# Generators that write a directory tree themselves rather than return data.
TREE_GENERATORS = {
    "python-workspace": python_workspace,
}

GENERATORS = {
    "encode-path": encode_path,
    "json-writers": json_writers,
    "guardrail-model": guardrail_model,
    "app-defaults": app_defaults,
    "lifecycle-lines": lifecycle_lines,
    "reconcile-cases": reconcile_cases,
    "hook-cases": hook_cases,
    "probe-runner-calls": probe_runner_calls,
    "tui-calls": tui_calls,
    "health-calls": health_calls,
}

# Generators that take the output path.
PATH_GENERATORS = {
    "session-scenarios": run_session_scenarios,
}

ALL = [*GENERATORS, *TREE_GENERATORS, *PATH_GENERATORS]
if len(sys.argv) != 3 or sys.argv[1] not in ALL:
    sys.exit("usage: scripts/python-expectations <%s> <output-path>" % "|".join(ALL))
out = Path(sys.argv[2])
if sys.argv[1] in PATH_GENERATORS:
    data = PATH_GENERATORS[sys.argv[1]](out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(data, indent=2, ensure_ascii=True) + "\n")
    print(out)
    sys.exit(0)
if sys.argv[1] in TREE_GENERATORS:
    if out.exists():
        sys.exit(f"{out} already exists")
    TREE_GENERATORS[sys.argv[1]](out)
    print(out)
    sys.exit(0)
out.parent.mkdir(parents=True, exist_ok=True)
out.write_text(json.dumps(GENERATORS[sys.argv[1]](), indent=2, ensure_ascii=True) + "\n")
print(out)
