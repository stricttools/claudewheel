#!/usr/bin/env python3
"""Write every script the Python claudewheel deploys into the given directory,
one file per script name, so the Go port's output can be compared with it byte
for byte. Run it with the interpreter that imports this checkout's claudewheel
package (the uv tool install's python). Writes nothing else."""
import sys
from pathlib import Path

from claudewheel.hook_scripts import HOOK_SCRIPTS

if len(sys.argv) != 2:
    sys.exit("usage: scripts/python-hook-scripts <output-directory>")
out = Path(sys.argv[1])
out.mkdir(parents=True, exist_ok=True)
for name, text in sorted(HOOK_SCRIPTS.items()):
    (out / name).write_text(text, encoding="utf-8", newline="")
    print(name)
