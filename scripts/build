#!/usr/bin/env bash
# Builds the claudewheel binary to the given path, stamping the version
# recorded in VERSION into it at link time (main.Version).
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "usage: scripts/build <output-path>" >&2
	exit 1
fi
out="$1"
# The output path is resolved against the directory the script is run from,
# before it changes to the repository root.
if [[ "${out}" != /* ]]; then
	out="${PWD}/${out}"
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(<"${root}/VERSION")"
if [[ ! "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	echo "scripts/build: ${root}/VERSION must hold one MAJOR.MINOR.PATCH version, found '${version}'" >&2
	exit 1
fi

cd "${root}"
go build -ldflags "-X main.Version=${version}" -o "${out}" ./cmd/claudewheel
