#!/usr/bin/env bash
# Runs a read-only command of a Go claudewheel binary against the live
# workspace before it was converted: copies of config.json and state.json,
# converted by the Go binary's upgrade-workspace under a throwaway HOME in
# experiments/live, are bind-mounted over the live files inside a private mount
# namespace, so the live files are never written and the command sees a
# converted workspace. The command runs as the invoking user again (a nested
# user namespace), so ownership and permission checks read as they would live.
# Pass only commands that write nothing: health, a --dry-run, show, probe list.
set -euo pipefail

if [[ $# -lt 2 ]]; then
	echo "usage: scripts/go-live-check <go-claudewheel-binary> <command> [args...]" >&2
	exit 1
fi
binary="$(realpath "$1")"
shift
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
live="${HOME}/.claudewheel"
scratch_home="${root}/experiments/live/home"
copy="${scratch_home}/.claudewheel"

mkdir -p "${copy}/themes"
for f in config.json state.json options.json segments.json shared-settings.json; do
	cp -p "${live}/${f}" "${copy}/${f}"
done
cp -rpT "${live}/themes" "${copy}/themes"
HOME="${scratch_home}" "${binary}" --quiet upgrade-workspace >&2

uid="$(id -u)"
gid="$(id -g)"
printf -v cmd '%q ' "${binary}" "$@"
exec unshare --map-root-user --mount bash -c "
	mount --bind '${copy}/config.json' '${live}/config.json' &&
	mount --bind '${copy}/state.json' '${live}/state.json' &&
	exec unshare --user --map-user=${uid} --map-group=${gid} bash -c '${cmd}'"
